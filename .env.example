# SamadhanPath Microservices Environment Variables

# ==========================================
# DATABASE CONNECTIONS
# ==========================================
# PostgreSQL (Gateway, Education, Public Services)
POSTGRES_GATEWAY_URL=postgresql://postgres:password@localhost:5432/samadhanpath_db
POSTGRES_EDUCATION_URL=postgresql://postgres:password@localhost:5432/education_db
POSTGRES_PUBLIC_SERVICES_URL=postgresql://postgres:password@localhost:5432/public_services_db

# MongoDB (Healthcare)
MONGODB_URL=mongodb://admin:password@localhost:27017/healthcare_db?authSource=admin

# MySQL (Agriculture)
MYSQL_HOST=localhost
MYSQL_USER=agric_user
MYSQL_PASSWORD=password
MYSQL_DATABASE=agriculture_db
MYSQL_PORT=3306

# SQLite (Infrastructure)
SQLITE_PATH=./infrastructure.db

# ==========================================
# PORTS & ENDPOINTS
# ==========================================
FRONTEND_PORT=3000
GATEWAY_PORT=5000
EDUCATION_PORT=4001
HEALTHCARE_PORT=4002
AGRICULTURE_PORT=4003
INFRASTRUCTURE_PORT=4004
PUBLIC_SERVICES_PORT=4005

# Gateway URLs for inter-service communication
EDUCATION_SERVICE_URL=http://localhost:4001
HEALTHCARE_SERVICE_URL=http://localhost:4002
AGRICULTURE_SERVICE_URL=http://localhost:4003
INFRASTRUCTURE_SERVICE_URL=http://localhost:4004
PUBLIC_SERVICES_URL=http://localhost:4005

# ==========================================
# SECURITY
# ==========================================
JWT_SECRET=super_secret_jwt_key_for_samadhanpath_hackathon
